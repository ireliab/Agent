# Model server (OpenAI-compatible, e.g. vLLM)
MODEL_BASE_URL=http://localhost:8000/v1
MODEL_API_KEY=
MODEL_NAME=your-model-name

# Tools
TAVILY_API_KEY=

# Tracing (optional - set LANGSMITH_TRACING=false to turn off)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Test

# Guardrails: caps per run, and the token count at which old tool
# results get dropped from context. Keep the trigger well below your
# model server's context length.
MAX_MODEL_CALLS=25
MAX_TOOL_CALLS=40
CONTEXT_EDIT_TRIGGER=16000
# Graph super-steps per run. Must stay well above MAX_MODEL_CALLS
# (~6 super-steps are spent per model call) or this fires first and
# raises instead of stopping cleanly. Defaults to MAX_MODEL_CALLS * 8 + 20.
RECURSION_LIMIT=220

# Tools that pause for your approval before running (empty disables the step)
INTERRUPT_TOOLS=write_docx,write_text_file
# Ask the model server for token counts while streaming. langchain turns this
# off by default whenever a custom base_url is set; vLLM supports it.
STREAM_USAGE=true
